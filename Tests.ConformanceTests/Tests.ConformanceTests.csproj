<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>Couchbase.ConformanceTests</RootNamespace>
        <NoWarn>$(NoWarn);MEVD9000</NoWarn> <!-- Microsoft.Extensions.VectorData experimental user-facing APIs -->
        <NoWarn>$(NoWarn);MEVD9001</NoWarn> <!-- Microsoft.Extensions.VectorData experimental provider-facing APIs -->
        <NoWarn>$(NoWarn);SKEXP0020</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.9.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
        <PackageReference Include="CouchbaseNetClient" Version="3.9.4" />
        <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.8.0" />
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.VectorData.ConformanceTests" Version="10.8.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Couchbase.VectorData/Couchbase.VectorData.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Support\" />
    </ItemGroup>

</Project>